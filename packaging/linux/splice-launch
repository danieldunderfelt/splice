#!/bin/sh
# Start Splice with the account's configured input-group membership.
#
# A lingering systemd --user manager can survive a logout and keep its old
# supplementary groups indefinitely.  Services (and sometimes desktop apps)
# then inherit that stale list even after `usermod -aG input` succeeded.  `sg`
# is the standard setgid helper and can activate a group already assigned to
# the account without requiring the stale parent process to have it.

set -eu

splice_binary="${HOME}/.local/bin/splice"
account_name="$(id -un)"
primary_group="$(id -gn)"
case "${0}" in
    /*) launcher_path="${0}" ;;
    *) launcher_path="$(pwd)/${0}" ;;
esac

has_input_group() {
    case " $1 " in
        *" input "*) return 0 ;;
        *) return 1 ;;
    esac
}

# `sg input` has to make input the primary group. That would make portal
# ptrace-style credential checks fail, so enter the input group first and then
# switch the primary group back while retaining input as a supplementary group.
case "${SPLICE_GROUP_STAGE:-}" in
    input)
        export SPLICE_GROUP_STAGE=primary
        exec sg "${SPLICE_PRIMARY_GROUP}" -c 'exec "$SPLICE_LAUNCHER"'
        ;;
    primary)
        exec "${splice_binary}" "$@"
        ;;
esac

# Avoid the helper when this process already inherited the group normally.
if has_input_group "$(id -nG)"; then
    exec "${splice_binary}" "$@"
fi

# Passing the account name makes `id` consult NSS instead of merely printing
# this process's (possibly stale) supplementary group list.
if command -v sg >/dev/null 2>&1 && has_input_group "$(id -nG "${account_name}")"; then
    export SPLICE_GROUP_STAGE=input
    export SPLICE_LAUNCHER="${launcher_path}"
    export SPLICE_PRIMARY_GROUP="${primary_group}"
    exec sg input -c 'exec "$SPLICE_LAUNCHER"'
fi

# Keep the app usable before setup is complete; its health panel explains the
# reduced physical-input monitoring and how to grant access.
exec "${splice_binary}" "$@"
