# Maintainer: Daniel Dunderfelt <dev@developsuperpowers.com>
pkgname=splice
pkgver=1.0.0
pkgrel=1
pkgdesc="Software KVM: share one keyboard and mouse across your Tailscale machines"
arch=('x86_64' 'aarch64')
url="https://github.com/danieldunderfelt/splice"
license=('MIT')
depends=('gcc-libs' 'glibc' 'wayland' 'libxkbcommon')
optdepends=('tailscale: peer discovery and transport'
            'xdg-desktop-portal-gnome: GNOME portal backend'
            'xdg-desktop-portal-kde: KDE Plasma portal backend'
            'vulkan-icd-loader: GPU rendering')
makedepends=('cargo' 'git')
source=("git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release -p splice-app
}

package() {
    cd "$pkgname"
    install -Dm0755 target/release/splice "$pkgdir/usr/bin/splice"
    install -Dm0644 packaging/linux/io.github.danieldunderfelt.Splice.desktop \
        -t "$pkgdir/usr/share/applications/"
    install -Dm0644 packaging/linux/io.github.danieldunderfelt.Splice.metainfo.xml \
        -t "$pkgdir/usr/share/metainfo/"
    install -Dm0644 packaging/linux/app-splice.service -t "$pkgdir/usr/lib/systemd/user/"
    install -Dm0644 packaging/linux/70-splice.rules -t "$pkgdir/usr/lib/udev/rules.d/"
    install -Dm0644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
    install -Dm0644 README.md docs/linux-setup.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
